				<description>&lt;ul&gt;&#xA;&lt;li&gt;&lt;a&#xD;&#xA;    href=&#34;https://code.visualstudio.com/api&#34;target=&#34;_blank&#34;&#xD;&#xA;    class=&#34;inline-flex items-center gap-1&#34;&#xD;&#xA;  &gt;官方API&lt;svg class=&#34;h-3 w-3 flex-shrink-0&#34; id=&#34;external-link&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;path fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6&#34;/&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a&#xD;&#xA;    href=&#34;https://github.com/microsoft/vscode-extension-samples&#34;target=&#34;_blank&#34;&#xD;&#xA;    class=&#34;inline-flex items-center gap-1&#34;&#xD;&#xA;  &gt;官方案例&lt;svg class=&#34;h-3 w-3 flex-shrink-0&#34; id=&#34;external-link&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;path fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6&#34;/&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a&#xD;&#xA;    href=&#34;https://rackar.github.io/vscode-ext-doccn/&#34;target=&#34;_blank&#34;&#xD;&#xA;    class=&#34;inline-flex items-center gap-1&#34;&#xD;&#xA;  &gt;中文翻译&lt;svg class=&#34;h-3 w-3 flex-shrink-0&#34; id=&#34;external-link&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;path fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6&#34;/&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h1 id=&#34;项目管理&#34;&gt;项目管理&lt;a href=&#34;#%e9%a1%b9%e7%9b%ae%e7%ae%a1%e7%90%86&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;h2 id=&#34;项目创建&#34;&gt;项目创建&lt;a href=&#34;#%e9%a1%b9%e7%9b%ae%e5%88%9b%e5%bb%ba&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h2&gt;&lt;div&#xD;&#xA;  class=&#34;term-block my-6 overflow-hidden rounded-xl border shadow-sm&#34;&#xD;&#xA;  data-term-block&#xD;&#xA;  data-term-id=&#34;term-0&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;term-header flex items-center justify-between border-b px-4 py-3&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;flex items-center gap-3&#34;&gt;&#xD;&#xA;      &lt;span class=&#34;flex items-center gap-1.5&#34; aria-hidden=&#34;true&#34;&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#ff5f57]&#34;&gt;&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#febc2e]&#34;&gt;&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#28c840]&#34;&gt;&lt;/span&gt;&#xD;&#xA;      &lt;/span&gt;&#xD;&#xA;      &lt;span class=&#34;term-title text-sm font-medium&#34;&gt;Terminal&lt;/span&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;  &lt;div class=&#34;overflow-x-auto p-4&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;term-body font-mono text-sm leading-relaxed&#34;&gt;&lt;div class=&#34;group relative pr-10&#34; data-term-group data-copy=&#34;npm install -g yo generator-code&#34;&gt;&#xD;&#xA;            &lt;button&#xD;&#xA;              class=&#34;term-copy-btn absolute top-0 right-0 z-10 flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium opacity-0 transition-all duration-200 ease-out group-hover:opacity-100 focus:ring-2 focus:ring-[#3fb950]/20 focus:outline-none&#34;&#xD;&#xA;              type=&#34;button&#34;&#xD;&#xA;              data-term-copy&#xD;&#xA;              data-label-copy=&#34;Copy&#34;&#xD;&#xA;              data-label-copied=&#34;Copied&#34;&#xD;&#xA;              title=&#34;Copy&#34;&#xD;&#xA;              aria-label=&#34;Copy&#34;&#xD;&#xA;            &gt;&#xD;&#xA;              &lt;span class=&#34;copy-icon&#34;&gt;&#xD;&#xA;                &lt;svg class=&#34;h-3 w-3&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;              &lt;/span&gt;&#xD;&#xA;              &lt;span class=&#34;copy-text hidden sm:inline&#34;&gt;Copy&lt;/span&gt;&#xD;&#xA;            &lt;/button&gt;&#xD;&#xA;            &lt;div class=&#34;whitespace-pre&#34;&gt;&lt;div&gt;&lt;span class=&#34;term-prompt font-semibold select-none&#34;&gt;$&lt;/span&#xD;&#xA;                    &gt;&lt;span class=&#34;pl-2&#34;&gt;npm install -g yo generator-code&lt;/span&gt;&lt;span class=&#34;term-comment pl-2 italic select-none&#34;&gt;# 项目脚手架&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;          &lt;/div&gt;&lt;div class=&#34;group relative pr-10&#34; data-term-group data-copy=&#34;yo code&#34;&gt;&#xD;&#xA;            &lt;button&#xD;&#xA;              class=&#34;term-copy-btn absolute top-0 right-0 z-10 flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium opacity-0 transition-all duration-200 ease-out group-hover:opacity-100 focus:ring-2 focus:ring-[#3fb950]/20 focus:outline-none&#34;&#xD;&#xA;              type=&#34;button&#34;&#xD;&#xA;              data-term-copy&#xD;&#xA;              data-label-copy=&#34;Copy&#34;&#xD;&#xA;              data-label-copied=&#34;Copied&#34;&#xD;&#xA;              title=&#34;Copy&#34;&#xD;&#xA;              aria-label=&#34;Copy&#34;&#xD;&#xA;            &gt;&#xD;&#xA;              &lt;span class=&#34;copy-icon&#34;&gt;&#xD;&#xA;                &lt;svg class=&#34;h-3 w-3&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;              &lt;/span&gt;&#xD;&#xA;              &lt;span class=&#34;copy-text hidden sm:inline&#34;&gt;Copy&lt;/span&gt;&#xD;&#xA;            &lt;/button&gt;&#xD;&#xA;            &lt;div class=&#34;whitespace-pre&#34;&gt;&lt;div&gt;&lt;span class=&#34;term-prompt font-semibold select-none&#34;&gt;$&lt;/span&#xD;&#xA;                    &gt;&lt;span class=&#34;pl-2&#34;&gt;yo code&lt;/span&gt;&lt;span class=&#34;term-comment pl-2 italic select-none&#34;&gt;# 配置项目&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;          &lt;/div&gt;&lt;div class=&#34;group relative pr-10&#34; data-term-group data-copy=&#34;tree -L 1&#34;&gt;&#xD;&#xA;            &lt;button&#xD;&#xA;              class=&#34;term-copy-btn absolute top-0 right-0 z-10 flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium opacity-0 transition-all duration-200 ease-out group-hover:opacity-100 focus:ring-2 focus:ring-[#3fb950]/20 focus:outline-none&#34;&#xD;&#xA;              type=&#34;button&#34;&#xD;&#xA;              data-term-copy&#xD;&#xA;              data-label-copy=&#34;Copy&#34;&#xD;&#xA;              data-label-copied=&#34;Copied&#34;&#xD;&#xA;              title=&#34;Copy&#34;&#xD;&#xA;              aria-label=&#34;Copy&#34;&#xD;&#xA;            &gt;&#xD;&#xA;              &lt;span class=&#34;copy-icon&#34;&gt;&#xD;&#xA;                &lt;svg class=&#34;h-3 w-3&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;              &lt;/span&gt;&#xD;&#xA;              &lt;span class=&#34;copy-text hidden sm:inline&#34;&gt;Copy&lt;/span&gt;&#xD;&#xA;            &lt;/button&gt;&#xD;&#xA;            &lt;div class=&#34;whitespace-pre&#34;&gt;&lt;div&gt;&lt;span class=&#34;term-prompt font-semibold select-none&#34;&gt;$&lt;/span&#xD;&#xA;                    &gt;&lt;span class=&#34;pl-2&#34;&gt;tree -L 1&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;          &lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;.&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;├── CHANGELOG.md&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;├── README.md&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;├── package Config.json&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;├── package-lock.json&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;├── package.json                    # 配置项目文件 &lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;├── src&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;# 插件代码&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;├── tsconfig.json                   # ts 配置文件&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;└── vsc-extension-quickstart.md&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;h2 id=&#34;项目配置&#34;&gt;项目配置&lt;a href=&#34;#%e9%a1%b9%e7%9b%ae%e9%85%8d%e7%bd%ae&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h2&gt;&lt;div&#xD;&#xA;    class=&#34;alert alert-note my-6 overflow-hidden rounded-lg transition-all duration-200 ease-out hover:-translate-y-0.5 hover:shadow-md&#34;&#xD;&#xA;    style=&#34;background-color: color-mix(in srgb, var(--color-note) 10%, transparent);&#xD;&#xA;              border-left-color: var(--color-note);&#xD;&#xA;              --hover-bg: color-mix(in srgb, var(--color-note) 15%, transparent);&#34;&#xD;&#xA;    onmouseover=&#34;this.style.backgroundColor = this.style.getPropertyValue(&#39;--hover-bg&#39;)&#34;&#xD;&#xA;    onmouseout=&#34;this.style.backgroundColor = &#39;color-mix(in srgb, var(--color-note) 10%, transparent)&#39;&#34;&#xD;&#xA;    role=&#34;alert&#34;&#xD;&#xA;    aria-labelledby=&#34;alert-0-title&#34;&#xD;&#xA;  &gt;&#xD;&#xA;    &#xD;&#xA;    &lt;div&#xD;&#xA;      class=&#34; flex items-center justify-between px-6 py-6&#34;&#xD;&#xA;      &#xD;&#xA;    &gt;&#xD;&#xA;      &lt;div class=&#34;flex items-center gap-3&#34;&gt;&#xD;&#xA;        &#xD;&#xA;        &lt;h4 id=&#34;alert-0-title&#34; class=&#34;text-foreground/90 m-0 font-semibold&#34;&gt;&#xD;&#xA;          Note&#xD;&#xA;        &lt;/h4&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;      &#xD;&#xA;      &#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &#xD;&#xA;    &lt;div&#xD;&#xA;      id=&#34;alert-0-content&#34;&#xD;&#xA;      class=&#34;alert-content  px-6 pb-6&#34;&#xD;&#xA;    &gt;&#xD;&#xA;      &lt;div class=&#34;prose prose-sm text-foreground/90 max-w-none&#34;&gt;&#xD;&#xA;        &lt;p&gt;&lt;a&#xD;&#xA;    href=&#34;https://code.visualstudio.com/api/ux-guidelines/overview&#34;target=&#34;_blank&#34;&#xD;&#xA;    class=&#34;inline-flex items-center gap-1&#34;&#xD;&#xA;  &gt;界面 UI&lt;svg class=&#34;h-3 w-3 flex-shrink-0&#34; id=&#34;external-link&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;path fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6&#34;/&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt; 交互都是通过 &lt;a&#xD;&#xA;    href=&#34;https://code.visualstudio.com/api/references/contribution-points&#34;target=&#34;_blank&#34;&#xD;&#xA;    class=&#34;inline-flex items-center gap-1&#34;&#xD;&#xA;  &gt;contributes&lt;svg class=&#34;h-3 w-3 flex-shrink-0&#34; id=&#34;external-link&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;path fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6&#34;/&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt; 进行配置&lt;/p&gt;</description>
			</item>
			<item>
				<title>API</title>
				<link>https://spite-triangle.github.io/cpp_notes/posts/vscode/api/</link>
				<pubDate>Sun, 19 Oct 2025 00:00:00 +0000</pubDate>
				<guid>https://spite-triangle.github.io/cpp_notes/posts/vscode/api/</guid>
				<description>&lt;h1 id=&#34;通用模式&#34;&gt;通用模式&lt;a href=&#34;#%e9%80%9a%e7%94%a8%e6%a8%a1%e5%bc%8f&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;h2 id=&#34;基础模块&#34;&gt;基础模块&lt;a href=&#34;#%e5%9f%ba%e7%a1%80%e6%a8%a1%e5%9d%97&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h2&gt;&lt;p&gt;通过 &lt;a&#xD;&#xA;    href=&#34;https://www.npmjs.com/package/util-kit&#34;target=&#34;_blank&#34;&#xD;&#xA;    class=&#34;inline-flex items-center gap-1&#34;&#xD;&#xA;  &gt;util-kit&lt;svg class=&#34;h-3 w-3 flex-shrink-0&#34; id=&#34;external-link&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;path fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6&#34;/&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt; 库可以对 vscode 的核心基础模块实现进行测试。&lt;/p&gt;</description>
			</item>
			<item>
				<title>Webview</title>
				<link>https://spite-triangle.github.io/cpp_notes/posts/vscode/webview/</link>
				<pubDate>Sun, 14 Apr 2024 00:00:00 +0000</pubDate>
				<guid>https://spite-triangle.github.io/cpp_notes/posts/vscode/webview/</guid>
				<description>&lt;h1 id=&#34;简介&#34;&gt;简介&lt;a href=&#34;#%e7%ae%80%e4%bb%8b&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;p&gt;通过 &lt;code&gt;webview&lt;/code&gt; 可以在 vscode 中引入 Web 技术，创建更复杂的交互界面。若把 vscode 比作是浏览器的话，webview 就等效于浏览器中的 &lt;code&gt;iframe&lt;/code&gt; 控件。&lt;/p&gt;</description>
			</item>
			<item>
				<title>Debugger</title>
				<link>https://spite-triangle.github.io/cpp_notes/posts/vscode/debugger/</link>
				<pubDate>Sun, 12 May 2024 00:00:00 +0000</pubDate>
				<guid>https://spite-triangle.github.io/cpp_notes/posts/vscode/debugger/</guid>
				<description>&lt;h1 id=&#34;概念&#34;&gt;概念&lt;a href=&#34;#%e6%a6%82%e5%bf%b5&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;p&gt;&#xD;&#xA;&lt;figure&#xD;&#xA;  class=&#34;image-figure not-prose my-8&#34;&#xD;&#xA;  data-lightbox-enabled=&#34;&#xD;&#xA;    true&#xD;&#xA;  &#34;&#xD;&#xA;  data-gallery-type=&#34;auto&#34;&#xD;&#xA;  data-image-width=&#34;696&#34;&#xD;&#xA;  data-image-height=&#34;243&#34;&#xD;&#xA;  data-image-src=&#34;https://spite-triangle.github.io/cpp_notes/posts/vscode/debugger/resources/debug-arch1.png&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;image-container&#34;&gt;&#xD;&#xA;    &lt;img&#xD;&#xA;    src=&#34;https://spite-triangle.github.io/cpp_notes/posts/vscode/debugger/resources/debug-arch1.png&#34;&#xD;&#xA;    alt=&#34;debuger&#34;&#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;      &#xD;&#xA;      &#xD;&#xA;        &#xD;&#xA;          width=&#34;696&#34; height=&#34;243&#34;&#xD;&#xA;        &#xD;&#xA;      &#xD;&#xA;    &#xD;&#xA;    loading=&#34;lazy&#34;&#xD;&#xA;    decoding=&#34;async&#34;&#xD;&#xA;    data-gallery-src=&#34;https://spite-triangle.github.io/cpp_notes/posts/vscode/debugger/resources/debug-arch1.png&#34;&#xD;&#xA;    data-gallery-alt=&#34;debuger&#34;&#xD;&#xA;    data-gallery-title=&#34;&#34;&#xD;&#xA;  /&gt;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;  &lt;/figure&gt;&#xD;&#xA;&lt;/p&gt;&#xA;&lt;p&gt;vscode 启动程序调试是通过 &lt;a&#xD;&#xA;    href=&#34;https://microsoft.github.io/debug-adapter-protocol/&#34;target=&#34;_blank&#34;&#xD;&#xA;    class=&#34;inline-flex items-center gap-1&#34;&#xD;&#xA;  &gt;Debug Adapter Protocol&lt;svg class=&#34;h-3 w-3 flex-shrink-0&#34; id=&#34;external-link&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;path fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6&#34;/&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt; 实现。然而不同语言都拥有自己的 &lt;code&gt;Debugger&lt;/code&gt;，且这些调试器的实现规则也各不相同，不可能都遵循 &lt;code&gt;Debug Adapter Protocol&lt;/code&gt;，因此， vscode 需要 Debugger 按照 Debug Adapter Protocol 创建一个能与之交互的 &lt;code&gt;Debug Adapter&lt;/code&gt;。&lt;strong&gt;在 vscode 中添加调试器，其实是开发调试器的适配器，按照协议开发开发的调试器能直接配置到vscode 中进行使用。&lt;/strong&gt;&lt;/p&gt;</description>
			</item>
			<item>
				<title>声明语言特性</title>
				<link>https://spite-triangle.github.io/cpp_notes/posts/vscode/declarativelanguagefeature/</link>
				<pubDate>Sun, 19 May 2024 00:00:00 +0000</pubDate>
				<guid>https://spite-triangle.github.io/cpp_notes/posts/vscode/declarativelanguagefeature/</guid>
				<description>&lt;h1 id=&#34;介绍&#34;&gt;介绍&lt;a href=&#34;#%e4%bb%8b%e7%bb%8d&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;p&gt;在 vscode 中，语言特性分为两类：&lt;/p&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;声明语言特性 &lt;code&gt;Declarative language features&lt;/code&gt; : 属于文本编辑特性，vscode 已经提供了专门的 API 用于实现其功能&#xA;&lt;ul&gt;&#xA;&lt;li&gt;语法高亮&lt;/li&gt;&#xA;&lt;li&gt;括号匹配与自动补全&lt;/li&gt;&#xA;&lt;li&gt;固定代码片段补全&lt;/li&gt;&#xA;&lt;li&gt;代码缩进&lt;/li&gt;&#xA;&lt;li&gt;注释快捷键&lt;/li&gt;&#xA;&lt;li&gt;代码块折叠&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;/li&gt;&#xA;&lt;li&gt;程序语言特性 &lt;code&gt;Programmatic language features&lt;/code&gt; : 需要自己编写额外模块，对项目代码进行动态分析，才能实现相关功能。vscode 只提供了相关的界面展示接口，具体展示内容依赖于代码分析结果&#xA;&lt;ul&gt;&#xA;&lt;li&gt;API 提示&lt;/li&gt;&#xA;&lt;li&gt;自动补全&lt;/li&gt;&#xA;&lt;li&gt;跳转到定义&lt;/li&gt;&#xA;&lt;li&gt;语法检查&lt;/li&gt;&#xA;&lt;li&gt;格式化&lt;/li&gt;&#xA;&lt;li&gt;重命名&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;p&gt;为了提供更强的语言分析能力，vscode 运行用户自定义 &lt;code&gt;Language Server Protocol&lt;/code&gt; ，然后插件通过客户端的形式连接上语言服务。&lt;/p&gt;</description>
			</item>
			<item>
				<title>程序语言特性</title>
				<link>https://spite-triangle.github.io/cpp_notes/posts/vscode/programmaticlanguagefeatures/</link>
				<pubDate>Sat, 25 May 2024 00:00:00 +0000</pubDate>
				<guid>https://spite-triangle.github.io/cpp_notes/posts/vscode/programmaticlanguagefeatures/</guid>
				<description>&lt;h1 id=&#34;工作原理&#34;&gt;工作原理&lt;a href=&#34;#%e5%b7%a5%e4%bd%9c%e5%8e%9f%e7%90%86&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;p&gt;&#xD;&#xA;&lt;figure&#xD;&#xA;  class=&#34;image-figure not-prose my-8&#34;&#xD;&#xA;  data-lightbox-enabled=&#34;&#xD;&#xA;    true&#xD;&#xA;  &#34;&#xD;&#xA;  data-gallery-type=&#34;auto&#34;&#xD;&#xA;  data-image-width=&#34;968&#34;&#xD;&#xA;  data-image-height=&#34;516&#34;&#xD;&#xA;  data-image-src=&#34;https://spite-triangle.github.io/cpp_notes/posts/vscode/programmaticlanguagefeatures/resources/programicLanguageFeature.png&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;image-container&#34;&gt;&#xD;&#xA;    &lt;img&#xD;&#xA;    src=&#34;https://spite-triangle.github.io/cpp_notes/posts/vscode/programmaticlanguagefeatures/resources/programicLanguageFeature.png&#34;&#xD;&#xA;    alt=&#34;Programmatic&#34;&#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;      &#xD;&#xA;      &#xD;&#xA;        &#xD;&#xA;          width=&#34;968&#34; height=&#34;516&#34;&#xD;&#xA;        &#xD;&#xA;      &#xD;&#xA;    &#xD;&#xA;    loading=&#34;lazy&#34;&#xD;&#xA;    decoding=&#34;async&#34;&#xD;&#xA;    data-gallery-src=&#34;https://spite-triangle.github.io/cpp_notes/posts/vscode/programmaticlanguagefeatures/resources/programicLanguageFeature.png&#34;&#xD;&#xA;    data-gallery-alt=&#34;Programmatic&#34;&#xD;&#xA;    data-gallery-title=&#34;&#34;&#xD;&#xA;  /&gt;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;  &lt;/figure&gt;&#xD;&#xA;&lt;/p&gt;&#xA;&lt;p&gt;程序语言特性 &lt;code&gt;Programmatic language features&lt;/code&gt; : 需要自己编写额外的 &lt;code&gt;Language Server&lt;/code&gt; 对项目代码进行动态分析，才能实现例如语法检测、自动补全等功能。vscode 只提供了相关的界面展示接口，具体展示内容依赖于代码分析结果&lt;/p&gt;</description>
			</item>
			<item>
				<title>Event Emitter</title>
				<link>https://spite-triangle.github.io/cpp_notes/posts/vscode/event/</link>
				<pubDate>Fri, 05 Apr 2024 00:00:00 +0000</pubDate>
				<guid>https://spite-triangle.github.io/cpp_notes/posts/vscode/event/</guid>
				<description>&lt;blockquote&#xD;&#xA;    class=&#34;border-primary bg-muted/30 hover:bg-muted/40 my-6 rounded-r-lg border-l-4 py-4 pr-4 pl-6 italic transition-all duration-200 ease-out hover:translate-x-1&#34;&#xD;&#xA;  &gt;&#xD;&#xA;    &lt;div class=&#34;prose prose-sm max-w-none&#34;&gt;&#xD;&#xA;      &lt;p&gt;[!tip|style:flat]&#xA;该文档来自 &lt;a&#xD;&#xA;    href=&#34;https://github.com/wangmengHB/utilities-library/blob/master/packages/util-kit/docs/event.md&#34;target=&#34;_blank&#34;&#xD;&#xA;    class=&#34;inline-flex items-center gap-1&#34;&#xD;&#xA;  &gt;utilities-library&lt;svg class=&#34;h-3 w-3 flex-shrink-0&#34; id=&#34;external-link&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;path fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6&#34;/&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt;&lt;/p&gt;&#xA;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/blockquote&gt;&lt;script&gt;&#xD;&#xA;  function toggleAlert(alertId) {&#xD;&#xA;    const content = document.getElementById(alertId + &#34;-content&#34;);&#xD;&#xA;    const chevron = document.getElementById(alertId + &#34;-chevron&#34;);&#xD;&#xA;    const header = content.previousElementSibling;&#xD;&#xA;&#xD;&#xA;    if (content.classList.contains(&#34;hidden&#34;)) {&#xD;&#xA;      content.classList.remove(&#34;hidden&#34;);&#xD;&#xA;      chevron.style.transform = &#34;rotate(0deg)&#34;;&#xD;&#xA;      header.setAttribute(&#34;aria-expanded&#34;, &#34;true&#34;);&#xD;&#xA;    } else {&#xD;&#xA;      content.classList.add(&#34;hidden&#34;);&#xD;&#xA;      chevron.style.transform = &#34;rotate(-90deg)&#34;;&#xD;&#xA;      header.setAttribute(&#34;aria-expanded&#34;, &#34;false&#34;);&#xD;&#xA;    }&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;  &#xD;&#xA;  document.addEventListener(&#34;DOMContentLoaded&#34;, function () {&#xD;&#xA;    const collapsedAlerts = document.querySelectorAll(&#34;.alert-content.hidden&#34;);&#xD;&#xA;    collapsedAlerts.forEach(function (content) {&#xD;&#xA;      const alertId = content.id.replace(&#34;-content&#34;, &#34;&#34;);&#xD;&#xA;      const chevron = document.getElementById(alertId + &#34;-chevron&#34;);&#xD;&#xA;      if (chevron) {&#xD;&#xA;        chevron.style.transform = &#34;rotate(-90deg)&#34;;&#xD;&#xA;      }&#xD;&#xA;    });&#xD;&#xA;  });&#xD;&#xA;&lt;/script&gt;&#xD;&#xA;&lt;p&gt;The event-related utils can be found in &lt;code&gt;util-kit&lt;/code&gt; as below:&lt;/p&gt;</description>
			</item>
