				<description>&lt;ul&gt;&#xA;&lt;li&gt;&lt;a&#xD;&#xA;    href=&#34;https://protobuf.dev/programming-guides/proto3/&#34;target=&#34;_blank&#34;&#xD;&#xA;    class=&#34;inline-flex items-center gap-1&#34;&#xD;&#xA;  &gt;Proto3&lt;svg class=&#34;h-3 w-3 flex-shrink-0&#34; id=&#34;external-link&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;path fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6&#34;/&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a&#xD;&#xA;    href=&#34;https://lixiangyun.gitbook.io/protobuf3&#34;target=&#34;_blank&#34;&#xD;&#xA;    class=&#34;inline-flex items-center gap-1&#34;&#xD;&#xA;  &gt;中文文档&lt;svg class=&#34;h-3 w-3 flex-shrink-0&#34; id=&#34;external-link&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;path fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6&#34;/&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h1 id=&#34;工具&#34;&gt;工具&lt;a href=&#34;#%e5%b7%a5%e5%85%b7&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;h2 id=&#34;安装&#34;&gt;安装&lt;a href=&#34;#%e5%ae%89%e8%a3%85&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h2&gt;&lt;ol&gt;&#xA;&lt;li&gt;&lt;a&#xD;&#xA;    href=&#34;https://github.com/protocolbuffers/protobuf/releases/&#34;target=&#34;_blank&#34;&#xD;&#xA;    class=&#34;inline-flex items-center gap-1&#34;&#xD;&#xA;  &gt;下载&lt;svg class=&#34;h-3 w-3 flex-shrink-0&#34; id=&#34;external-link&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;path fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6&#34;/&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt; : &lt;strong&gt;由于工具要与动态库对应才能正常使用，因此这里下载也没啥用，还是得自己编译&lt;/strong&gt;&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;div&#xD;&#xA;  class=&#34;term-block my-6 overflow-hidden rounded-xl border shadow-sm&#34;&#xD;&#xA;  data-term-block&#xD;&#xA;  data-term-id=&#34;term-0&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;term-header flex items-center justify-between border-b px-4 py-3&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;flex items-center gap-3&#34;&gt;&#xD;&#xA;      &lt;span class=&#34;flex items-center gap-1.5&#34; aria-hidden=&#34;true&#34;&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#ff5f57]&#34;&gt;&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#febc2e]&#34;&gt;&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#28c840]&#34;&gt;&lt;/span&gt;&#xD;&#xA;      &lt;/span&gt;&#xD;&#xA;      &lt;span class=&#34;term-title text-sm font-medium&#34;&gt;Terminal&lt;/span&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;  &lt;div class=&#34;overflow-x-auto p-4&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;term-body font-mono text-sm leading-relaxed&#34;&gt;&lt;div class=&#34;group relative pr-10&#34; data-term-group data-copy=&#34;tree -L 2 .&#34;&gt;&#xD;&#xA;            &lt;button&#xD;&#xA;              class=&#34;term-copy-btn absolute top-0 right-0 z-10 flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium opacity-0 transition-all duration-200 ease-out group-hover:opacity-100 focus:ring-2 focus:ring-[#3fb950]/20 focus:outline-none&#34;&#xD;&#xA;              type=&#34;button&#34;&#xD;&#xA;              data-term-copy&#xD;&#xA;              data-label-copy=&#34;Copy&#34;&#xD;&#xA;              data-label-copied=&#34;Copied&#34;&#xD;&#xA;              title=&#34;Copy&#34;&#xD;&#xA;              aria-label=&#34;Copy&#34;&#xD;&#xA;            &gt;&#xD;&#xA;              &lt;span class=&#34;copy-icon&#34;&gt;&#xD;&#xA;                &lt;svg class=&#34;h-3 w-3&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;              &lt;/span&gt;&#xD;&#xA;              &lt;span class=&#34;copy-text hidden sm:inline&#34;&gt;Copy&lt;/span&gt;&#xD;&#xA;            &lt;/button&gt;&#xD;&#xA;            &lt;div class=&#34;whitespace-pre&#34;&gt;&lt;div&gt;&lt;span class=&#34;term-prompt font-semibold select-none&#34;&gt;$&lt;/span&#xD;&#xA;                    &gt;&lt;span class=&#34;pl-2&#34;&gt;tree -L 2 .&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;          &lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;.&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;├── bin&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;│   └── protoc.exe   # proto 编译工具&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;├── include&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;│   └── google       # 官方提供的 .proto 库&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;└── readme.txt&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;ol start=&#34;2&#34;&gt;&#xA;&lt;li&gt;将 &lt;code&gt;protoc.exe&lt;/code&gt; 所在路径添加到环境变量，方便使用&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;h2 id=&#34;命令行&#34;&gt;命令行&lt;a href=&#34;#%e5%91%bd%e4%bb%a4%e8%a1%8c&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h2&gt;&lt;div&#xD;&#xA;  class=&#34;term-block my-6 overflow-hidden rounded-xl border shadow-sm&#34;&#xD;&#xA;  data-term-block&#xD;&#xA;  data-term-id=&#34;term-1&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;term-header flex items-center justify-between border-b px-4 py-3&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;flex items-center gap-3&#34;&gt;&#xD;&#xA;      &lt;span class=&#34;flex items-center gap-1.5&#34; aria-hidden=&#34;true&#34;&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#ff5f57]&#34;&gt;&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#febc2e]&#34;&gt;&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#28c840]&#34;&gt;&lt;/span&gt;&#xD;&#xA;      &lt;/span&gt;&#xD;&#xA;      &lt;span class=&#34;term-title text-sm font-medium&#34;&gt;Terminal&lt;/span&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;  &lt;div class=&#34;overflow-x-auto p-4&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;term-body font-mono text-sm leading-relaxed&#34;&gt;&lt;div class=&#34;group relative pr-10&#34; data-term-group data-copy=&#34;protoc -h&#34;&gt;&#xD;&#xA;            &lt;button&#xD;&#xA;              class=&#34;term-copy-btn absolute top-0 right-0 z-10 flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium opacity-0 transition-all duration-200 ease-out group-hover:opacity-100 focus:ring-2 focus:ring-[#3fb950]/20 focus:outline-none&#34;&#xD;&#xA;              type=&#34;button&#34;&#xD;&#xA;              data-term-copy&#xD;&#xA;              data-label-copy=&#34;Copy&#34;&#xD;&#xA;              data-label-copied=&#34;Copied&#34;&#xD;&#xA;              title=&#34;Copy&#34;&#xD;&#xA;              aria-label=&#34;Copy&#34;&#xD;&#xA;            &gt;&#xD;&#xA;              &lt;span class=&#34;copy-icon&#34;&gt;&#xD;&#xA;                &lt;svg class=&#34;h-3 w-3&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;              &lt;/span&gt;&#xD;&#xA;              &lt;span class=&#34;copy-text hidden sm:inline&#34;&gt;Copy&lt;/span&gt;&#xD;&#xA;            &lt;/button&gt;&#xD;&#xA;            &lt;div class=&#34;whitespace-pre&#34;&gt;&lt;div&gt;&lt;span class=&#34;term-prompt font-semibold select-none&#34;&gt;$&lt;/span&#xD;&#xA;                    &gt;&lt;span class=&#34;pl-2&#34;&gt;protoc -h&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;          &lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;Options:&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;  -I[PATH], --proto_path=PATH Specify the directory in which to search for&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;                              imports.&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;  ...&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;  --cpp_out=OUT_DIR           Generate C&amp;#43;&amp;#43; header and source.&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;  --csharp_out=OUT_DIR        Generate C# source file.&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;  --java_out=OUT_DIR          Generate Java source file.&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;  --kotlin_out=OUT_DIR        Generate Kotlin file.&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;  --objc_out=OUT_DIR          Generate Objective-C header and source.&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;  --php_out=OUT_DIR           Generate PHP source file.&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;  --pyi_out=OUT_DIR           Generate python pyi stub.&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;  --python_out=OUT_DIR        Generate Python source file.&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;  --ruby_out=OUT_DIR          Generate Ruby source file.&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;  --rust_out=OUT_DIR          Generate Rust sources.&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;  ...&lt;/div&gt;&lt;div class=&#34;group relative pr-10&#34; data-term-group data-copy=&#34;protoc -I./ --cpp_out=./  test.proto&#34;&gt;&#xD;&#xA;            &lt;button&#xD;&#xA;      