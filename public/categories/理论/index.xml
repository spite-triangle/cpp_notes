			<item>
				<title>字符集</title>
				<link>https://spite-triangle.github.io/cpp_notes/posts/operatesystem/charset/</link>
				<pubDate>Sun, 30 Mar 2025 00:00:00 +0000</pubDate>
				<guid>https://spite-triangle.github.io/cpp_notes/posts/operatesystem/charset/</guid>
				<description>&lt;h1 id=&#34;ascii&#34;&gt;ASCII&lt;a href=&#34;#ascii&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;p&gt;&lt;strong&gt;ASCII 码&lt;/strong&gt;：利用一个字节长度 &lt;code&gt;0000 0000 ~ 0111 1111&lt;/code&gt; 储存 128 个字符&lt;/p&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;可见字符：数字，字母，共 95 个&lt;/li&gt;&#xA;&lt;li&gt;控制字符：控制打印输出的，例如换行 &lt;code&gt;\n&lt;/code&gt;，共 33 个&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;p&gt;&#xD;&#xA;&lt;figure&#xD;&#xA;  class=&#34;image-figure not-prose my-8&#34;&#xD;&#xA;  data-lightbox-enabled=&#34;&#xD;&#xA;    true&#xD;&#xA;  &#34;&#xD;&#xA;  data-gallery-type=&#34;auto&#34;&#xD;&#xA;  data-image-width=&#34;929&#34;&#xD;&#xA;  data-image-height=&#34;572&#34;&#xD;&#xA;  data-image-src=&#34;https://spite-triangle.github.io/cpp_notes/posts/operatesystem/charset/resources/ascii.png&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;image-container&#34;&gt;&#xD;&#xA;    &lt;img&#xD;&#xA;    src=&#34;https://spite-triangle.github.io/cpp_notes/posts/operatesystem/charset/resources/ascii.png&#34;&#xD;&#xA;    alt=&#34;alt&#34;&#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;      &#xD;&#xA;      &#xD;&#xA;        &#xD;&#xA;          width=&#34;929&#34; height=&#34;572&#34;&#xD;&#xA;        &#xD;&#xA;      &#xD;&#xA;    &#xD;&#xA;    loading=&#34;lazy&#34;&#xD;&#xA;    decoding=&#34;async&#34;&#xD;&#xA;    data-gallery-src=&#34;https://spite-triangle.github.io/cpp_notes/posts/operatesystem/charset/resources/ascii.png&#34;&#xD;&#xA;    data-gallery-alt=&#34;alt&#34;&#xD;&#xA;    data-gallery-title=&#34;&#34;&#xD;&#xA;  /&gt;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;  &lt;/figure&gt;&#xD;&#xA;&lt;/p&gt;</description>
