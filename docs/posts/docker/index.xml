			<item>
				<title>可视化工具</title>
				<link>https://spite-triangle.github.io/cpp_notes/posts/docker/visualization/</link>
				<pubDate>Sun, 03 Mar 2024 00:00:00 +0000</pubDate>
				<guid>https://spite-triangle.github.io/cpp_notes/posts/docker/visualization/</guid>
				<description>&lt;h1 id=&#34;官方客户端&#34;&gt;官方客户端&lt;a href=&#34;#%e5%ae%98%e6%96%b9%e5%ae%a2%e6%88%b7%e7%ab%af&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;p&gt;&#xD;&#xA;&lt;figure&#xD;&#xA;  class=&#34;image-figure not-prose my-8&#34;&#xD;&#xA;  data-lightbox-enabled=&#34;&#xD;&#xA;    true&#xD;&#xA;  &#34;&#xD;&#xA;  data-gallery-type=&#34;auto&#34;&#xD;&#xA;  data-image-width=&#34;1270&#34;&#xD;&#xA;  data-image-height=&#34;720&#34;&#xD;&#xA;  data-image-src=&#34;https://spite-triangle.github.io/cpp_notes/posts/docker/visualization/resources/docker_desktop.jpg&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;image-container&#34;&gt;&#xD;&#xA;    &lt;img&#xD;&#xA;    src=&#34;https://spite-triangle.github.io/cpp_notes/posts/docker/visualization/resources/docker_desktop.jpg&#34;&#xD;&#xA;    alt=&#34;desktop&#34;&#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;      &#xD;&#xA;      &#xD;&#xA;        &#xD;&#xA;          width=&#34;1270&#34; height=&#34;720&#34;&#xD;&#xA;        &#xD;&#xA;      &#xD;&#xA;    &#xD;&#xA;    loading=&#34;lazy&#34;&#xD;&#xA;    decoding=&#34;async&#34;&#xD;&#xA;    data-gallery-src=&#34;https://spite-triangle.github.io/cpp_notes/posts/docker/visualization/resources/docker_desktop.jpg&#34;&#xD;&#xA;    data-gallery-alt=&#34;desktop&#34;&#xD;&#xA;    data-gallery-title=&#34;&#34;&#xD;&#xA;  /&gt;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;  &lt;/figure&gt;&#xD;&#xA;&lt;/p&gt;&#xA;&lt;h1 id=&#34;portainer&#34;&gt;portainer&lt;a href=&#34;#portainer&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;ol&gt;&#xA;&lt;li&gt;安装&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;div&#xD;&#xA;  class=&#34;term-block my-6 overflow-hidden rounded-xl border shadow-sm&#34;&#xD;&#xA;  data-term-block&#xD;&#xA;  data-term-id=&#34;term-0&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;term-header flex items-center justify-between border-b px-4 py-3&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;flex items-center gap-3&#34;&gt;&#xD;&#xA;      &lt;span class=&#34;flex items-center gap-1.5&#34; aria-hidden=&#34;true&#34;&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#ff5f57]&#34;&gt;&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#febc2e]&#34;&gt;&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#28c840]&#34;&gt;&lt;/span&gt;&#xD;&#xA;      &lt;/span&gt;&#xD;&#xA;      &lt;span class=&#34;term-title text-sm font-medium&#34;&gt;Terminal&lt;/span&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;  &lt;div class=&#34;overflow-x-auto p-4&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;term-body font-mono text-sm leading-relaxed&#34;&gt;&lt;div class=&#34;group relative pr-10&#34; data-term-group data-copy=&#34;docker run -d -p 2333:9000 -v /var/run/docker.sock:/var/run/docker.sock --restart=always --name prtainer portainer/portainer&#34;&gt;&#xD;&#xA;            &lt;button&#xD;&#xA;              class=&#34;term-copy-btn absolute top-0 right-0 z-10 flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium opacity-0 transition-all duration-200 ease-out group-hover:opacity-100 focus:ring-2 focus:ring-[#3fb950]/20 focus:outline-none&#34;&#xD;&#xA;              type=&#34;button&#34;&#xD;&#xA;              data-term-copy&#xD;&#xA;              data-label-copy=&#34;Copy&#34;&#xD;&#xA;              data-label-copied=&#34;Copied&#34;&#xD;&#xA;              title=&#34;Copy&#34;&#xD;&#xA;              aria-label=&#34;Copy&#34;&#xD;&#xA;            &gt;&#xD;&#xA;              &lt;span class=&#34;copy-icon&#34;&gt;&#xD;&#xA;                &lt;svg class=&#34;h-3 w-3&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;              &lt;/span&gt;&#xD;&#xA;              &lt;span class=&#34;copy-text hidden sm:inline&#34;&gt;Copy&lt;/span&gt;&#xD;&#xA;            &lt;/button&gt;&#xD;&#xA;            &lt;div class=&#34;whitespace-pre&#34;&gt;&lt;div&gt;&lt;span class=&#34;term-prompt font-semibold select-none&#34;&gt;$&lt;/span&#xD;&#xA;                    &gt;&lt;span class=&#34;pl-2&#34;&gt;docker run -d -p 2333:9000 -v /var/run/docker.sock:/var/run/docker.sock --restart=always --name prtainer portainer/portainer&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;          &lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;-v : 将主机文件系统挂载到容器&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;--restart : 重启策略。容器退出时，是否重启容器&lt;/div&gt;&lt;div class=&#34;group relative pr-10&#34; data-term-group data-copy=&#34;file /var/run/docker.sock&#34;&gt;&#xD;&#xA;            &lt;button&#xD;&#xA;              class=&#34;term-copy-btn absolute top-0 right-0 z-10 flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium opacity-0 transition-all duration-200 ease-out group-hover:opacity-100 focus:ring-2 focus:ring-[#3fb950]/20 focus:outline-none&#34;&#xD;&#xA;              type=&#34;button&#34;&#xD;&#xA;              data-term-copy&#xD;&#xA;              data-label-copy=&#34;Copy&#34;&#xD;&#xA;              data-label-copied=&#34;Copied&#34;&#xD;&#xA;              title=&#34;Copy&#34;&#xD;&#xA;              aria-label=&#34;Copy&#34;&#xD;&#xA;            &gt;&#xD;&#xA;              &lt;span class=&#34;copy-icon&#34;&gt;&#xD;&#xA;                &lt;svg class=&#34;h-3 w-3&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;              &lt;/span&gt;&#xD;&#xA;              &lt;span class=&#34;copy-text hidden sm:inline&#34;&gt;Copy&lt;/span&gt;&#xD;&#xA;            &lt;/button&gt;&#xD;&#xA;            &lt;div class=&#34;whitespace-pre&#34;&gt;&lt;div&gt;&lt;span class=&#34;term-prompt font-semibold select-none&#34;&gt;$&lt;/span&#xD;&#xA;                    &gt;&lt;span class=&#34;pl-2&#34;&gt;file /var/run/docker.sock&lt;/span&gt;&lt;span class=&#34;term-comment pl-2 italic select-none&#34;&gt;# 用于与 docker 服务通信的 sock 文件&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;          &lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;/var/run/docker.sock: socket&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;ol start=&#34;2&#34;&gt;&#xA;&lt;li&gt;使用&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;div&#xD;&#xA;  class=&#34;term-block my-6 overflow-hidden rounded-xl border shadow-sm&#34;&#xD;&#xA;  data-term-block&#xD;&#xA;  data-term-id=&#34;term-1&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;term-header flex items-center justify-between border-b px-4 py-3&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;flex items-center gap-3&#34;&gt;&#xD;&#xA;      &lt;span class=&#34;flex items-center gap-1.5&#34; aria-hidden=&#34;true&#34;&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#ff5f57]&#34;&gt;&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#febc2e]&#34;&gt;&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#28c840]&#34;&gt;&lt;/span&gt;&#xD;&#xA;      &lt;/span&gt;&#xD;&#xA;      &lt;span class=&#34;term-title text-sm font-medium&#34;&gt;Terminal&lt;/span&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;  &lt;div class=&#34;overflow-x-auto p-4&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;term-body font-mono text-sm leading-relaxed&#34;&gt;&lt;div class=&#34;group relative pr-10&#34; data-term-group data-copy=&#34;ipconfig.exe&#34;&gt;&#xD;&#xA;            &lt;button&#xD;&#xA;              class=&#34;term-copy-btn absolute top-0 right-0 z-10 flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium opacity-0 transition-all duration-200 ease-out group-hover:opacity-100 focus:ring-2 focus:ring-[#3fb950]/20 focus:outline-none&#34;&#xD;&#xA;              type=&#34;button&#34;&#xD;&#xA;              data-term-copy&#xD;&#xA;              data-label-copy=&#34;Copy&#34;&#xD;&#xA;              data-label-copied=&#34;Copied&#34;&#xD;&#xA;              title=&#34;Copy&#34;&#xD;&#xA;              aria-label=&#34;Copy&#34;&#xD;&#xA;            &gt;&#xD;&#xA;              &lt;span class=&#34;copy-icon&#34;&gt;&#xD;&#xA;                &lt;svg class=&#34;h-3 w-3&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;              &lt;/span&gt;&#xD;&#xA;              &lt;span class=&#34;copy-text hidden sm:inline&#34;&gt;Copy&lt;/span&gt;&#xD;&#xA;            &lt;/button&gt;&#xD;&#xA;            &lt;div class=&#34;whitespace-pre&#34;&gt;&lt;div&gt;&lt;span class=&#34;term-prompt font-semibold select-none&#34;&gt;$&lt;/span&#xD;&#xA;                    &gt;&lt;span class=&#34;pl-2&#34;&gt;ipconfig.exe &lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;          &lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;    ...&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;以太网适配器 vEthernet (WSL):&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;   连接特定的 DNS 后缀 . . . . . . . :&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;   本地链接 IPv6 地址. . . . . . . . : fe80::ca1b:10c3:b774:dead%73&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;   IPv4 地址 . . . . . . . . . . . . : 172.18.160.1    # wsl2 的本机 ip 地址&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;   子网掩码  . . . . . . . . . . . . : 255.255.240.0&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;   默认网关. . . . . . . . . . . . . :&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;   ...&lt;/div&gt;&lt;div class=&#34;group relative pr-10&#34; data-term-group data-copy=&#34;curl 172.18.160.1:2333&#34;&gt;&#xD;&#xA;            &lt;button&#xD;&#xA;              class=&#34;term-copy-btn absolute top-0 right-0 z-10 flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium opacity-0 transition-all duration-200 ease-out group-hover:opacity-100 focus:ring-2 focus:ring-[#3fb950]/20 focus:outline-none&#34;&#xD;&#xA;              type=&#34;button&#34;&#xD;&#xA;              data-term-copy&#xD;&#xA;              data-label-copy