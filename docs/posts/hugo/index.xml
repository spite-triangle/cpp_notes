label-copied=&#34;Copied&#34;&#xD;&#xA;        title=&#34;Copy&#34;&#xD;&#xA;        aria-label=&#34;Copy&#34;&#xD;&#xA;      &gt;&#xD;&#xA;        &lt;span class=&#34;copy-icon&#34;&gt;&#xD;&#xA;          &lt;svg class=&#34;h-3 w-3&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;        &lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;copy-text hidden sm:inline&#34;&gt;Copy&lt;/span&gt;&#xD;&#xA;      &lt;/button&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;  &#xD;&#xA;  &lt;div class=&#34;code-block-content relative&#34; id=&#34;code-0&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-txt&#34; data-lang=&#34;txt&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;content/&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;├── articles/             &amp;lt;-- top-level directory&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│   ├── 2022/&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│   │   ├── article-1.md&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│   │   └── article-2.md&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│   └── 2023/&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       ├── article-3.md&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       └── article-4.md&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;├── products/             &amp;lt;-- top-level directory&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│   └── product-2/&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       ├── benefits/&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       │   ├── _index.md&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       │   ├── benefit-1.md&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       │   └── benefit-2.md&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       ├── features/&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       │   ├── _index.md&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       │   ├── feature-1.md&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       │   └── feature-2.md&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       └── _index.md&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;└── about.md&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&#xD;&#xA;    &lt;div hidden data-code-source&gt;content/&#xA;├── articles/             &amp;lt;-- top-level directory&#xA;│   ├── 2022/&#xA;│   │   ├── article-1.md&#xA;│   │   └── article-2.md&#xA;│   └── 2023/&#xA;│       ├── article-3.md&#xA;│       └── article-4.md&#xA;├── products/             &amp;lt;-- top-level directory&#xA;│   └── product-2/&#xA;│       ├── benefits/&#xA;│       │   ├── _index.md&#xA;│       │   ├── benefit-1.md&#xA;│       │   └── benefit-2.md&#xA;│       ├── features/&#xA;│       │   ├── _index.md&#xA;│       │   ├── feature-1.md&#xA;│       │   └── feature-2.md&#xA;│       └── _index.md&#xA;└── about.md&lt;/div&gt;&#xD;&#xA;    &#xD;&#xA;    &lt;div&#xD;&#xA;      class=&#34;collapse-overlay to-card/90 pointer-events-none absolute inset-0 bg-linear-to-b from-transparent via-transparent opacity-0 transition-opacity duration-300&#34;&#xD;&#xA;      hidden&#xD;&#xA;    &gt;&#xD;&#xA;      &lt;button&#xD;&#xA;        class=&#34;collapse-overlay-btn text-muted-foreground bg-card/80 border-border/50 hover:bg-primary/10 hover:text-primary hover:border-primary/30 absolute bottom-4 left-1/2 flex -translate-x-1/2 items-center justify-center rounded-full border p-2 backdrop-blur-sm transition-all duration-200&#34;&#xD;&#xA;        type=&#34;button&#34;&#xD;&#xA;        data-code-action=&#34;expand&#34;&#xD;&#xA;        aria-label=&#34;Expand&#34;&#xD;&#xA;        title=&#34;Expand&#34;&#xD;&#xA;      &gt;&#xD;&#xA;        &lt;svg class=&#34;h-4 w-4&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M19 9l-7 7-7-7&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;      &lt;/button&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;p&gt;静态网页所展示的内容均来自于 &lt;code&gt;content/&lt;/code&gt; 目录 (目录，泛指文件夹与文件)&lt;/p&gt;</description>
			</item>
			<item>
				<title>Taxonomies</title>
				<link>http://localhost:1313/cpp_notes/posts/hugo/taxonomies/</link>
				<pubDate>Mon, 03 Aug 2026 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/cpp_notes/posts/hugo/taxonomies/</guid>
				<description>&lt;h1 id=&#34;分类学&#34;&gt;分类学&lt;a href=&#34;#%e5%88%86%e7%b1%bb%e5%ad%a6&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;h2 id=&#34;概念&#34;&gt;概念&lt;a href=&#34;#%e6%a6%82%e5%bf%b5&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;分类学&lt;/strong&gt; &lt;code&gt;Taxonomies&lt;/code&gt;: 通过&lt;a&#xD;&#xA;    href=&#34;./content.md&#34;&gt;内容组织&lt;/a&gt;实现的 &lt;code&gt;section&lt;/code&gt; 只能实现文档物理存储上的分组，而通过 &lt;code&gt;Taxonomies&lt;/code&gt; 则可实现文档平面化的分类。&lt;/p&gt;</description>
			</item>
			<item>
				<title>模板</title>
				<link>http://localhost:1313/cpp_notes/posts/hugo/template/</link>
				<pubDate>Mon, 03 Aug 2026 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/cpp_notes/posts/hugo/template/</guid>
				<description>&lt;h1 id=&#34;概念&#34;&gt;概念&lt;a href=&#34;#%e6%a6%82%e5%bf%b5&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;p&gt;&lt;strong&gt;模板 &lt;code&gt;Template&lt;/code&gt;&lt;/strong&gt; : 指的是 &lt;code&gt;web&lt;/code&gt; 中一种生成&lt;code&gt;html&lt;/code&gt;页面的技术，用于定义页面如何渲染展示。&lt;code&gt;hugo&lt;/code&gt; 会基于 &lt;code&gt;layout/&lt;/code&gt; 中定义的 &lt;code&gt;Template&lt;/code&gt; 将 &lt;code&gt;content/&lt;/code&gt; 中的内容渲染成 &lt;code&gt;web&lt;/code&gt; 界面。&lt;/p&gt;</description>
			</item>
			<item>
				<title>WEB</title>
				<link>http://localhost:1313/cpp_notes/posts/hugo/web/</link>
				<pubDate>Tue, 04 Aug 2026 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/cpp_notes/posts/hugo/web/</guid>
				<description>&lt;h1 id=&#34;网页类型&#34;&gt;网页类型&lt;a href=&#34;#%e7%bd%91%e9%a1%b5%e7%b1%bb%e5%9e%8b&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;p&gt;根据 &lt;a&#xD;&#xA;    href=&#34;./template.md&#34;&gt;template&lt;/a&gt; 可知网页类型主要有&lt;/p&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;&lt;code&gt;home&lt;/code&gt;: 主界面&lt;/li&gt;&#xA;&lt;li&gt;&lt;code&gt;page&lt;/code&gt;: 文章正文&lt;/li&gt;&#xA;&lt;li&gt;&lt;code&gt;section&lt;/code&gt;: 展示 &lt;code&gt;section&lt;/code&gt; 中文章条目&lt;/li&gt;&#xA;&lt;li&gt;&lt;code&gt;taxonomy&lt;/code&gt;: 展示 &lt;code&gt;term&lt;/code&gt; 选项&lt;/li&gt;&#xA;&lt;li&gt;&lt;code&gt;term&lt;/code&gt;: 展示与 &lt;code&gt;term&lt;/code&gt; 关联的文章条目&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;p&gt;根据 &lt;a&#xD;&#xA;    href=&#34;./content.md&#34;&gt;content&lt;/a&gt; 可知上述网页又可以划分为两大类&lt;/p&gt;</description>
			</item>
			<item>
				<title>配置</title>
				<link>http://localhost:1313/cpp_notes/posts/hugo/config/</link>
				<pubDate>Mon, 03 Aug 2026 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/cpp_notes/posts/hugo/config/</guid>
				<description>&lt;h1 id=&#34;目录结构&#34;&gt;目录结构&lt;a href=&#34;#%e7%9b%ae%e5%bd%95%e7%bb%93%e6%9e%84&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;p&gt;&lt;code&gt;hugo&lt;/code&gt; 的配置文件允许多种格式&lt;/p&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;&#xA;&lt;p&gt;&lt;code&gt;toml&lt;/code&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li&gt;&#xA;&lt;p&gt;&lt;code&gt;yaml&lt;/code&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li&gt;&#xA;&lt;p&gt;&lt;code&gt;json&lt;/code&gt;&#xA;且配置文件可以放在不同位置&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li&gt;&#xA;&lt;p&gt;&lt;strong&gt;单配置文件&lt;/strong&gt;: 命名为 &lt;code&gt;hugo.toml&lt;/code&gt; 的主配置文件&lt;/p&gt;</description>
			</item>
