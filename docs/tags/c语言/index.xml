			<item>
				<title>GDB</title>
				<link>http://localhost:1313/cpp_notes/posts/linuxcommand/gdb/</link>
				<pubDate>Mon, 07 Apr 2025 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/cpp_notes/posts/linuxcommand/gdb/</guid>
				<description>&lt;h1 id=&#34;执行&#34;&gt;执行&lt;a href=&#34;#%e6%89%a7%e8%a1%8c&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;p&gt;&lt;strong&gt;启动：&lt;/strong&gt;&lt;/p&gt;&#xA;&lt;div&#xD;&#xA;  class=&#34;term-block my-6 overflow-hidden rounded-xl border shadow-sm&#34;&#xD;&#xA;  data-term-block&#xD;&#xA;  data-term-id=&#34;term-0&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;term-header flex items-center justify-between border-b px-4 py-3&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;flex items-center gap-3&#34;&gt;&#xD;&#xA;      &lt;span class=&#34;flex items-center gap-1.5&#34; aria-hidden=&#34;true&#34;&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#ff5f57]&#34;&gt;&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#febc2e]&#34;&gt;&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#28c840]&#34;&gt;&lt;/span&gt;&#xD;&#xA;      &lt;/span&gt;&#xD;&#xA;      &lt;span class=&#34;term-title text-sm font-medium&#34;&gt;Terminal&lt;/span&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;  &lt;div class=&#34;overflow-x-auto p-4&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;term-body font-mono text-sm leading-relaxed&#34;&gt;&lt;div class=&#34;group relative pr-10&#34; data-term-group data-copy=&#34;gdb&#34;&gt;&#xD;&#xA;            &lt;button&#xD;&#xA;              class=&#34;term-copy-btn absolute top-0 right-0 z-10 flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium opacity-0 transition-all duration-200 ease-out group-hover:opacity-100 focus:ring-2 focus:ring-[#3fb950]/20 focus:outline-none&#34;&#xD;&#xA;              type=&#34;button&#34;&#xD;&#xA;              data-term-copy&#xD;&#xA;              data-label-copy=&#34;Copy&#34;&#xD;&#xA;              data-label-copied=&#34;Copied&#34;&#xD;&#xA;              title=&#34;Copy&#34;&#xD;&#xA;              aria-label=&#34;Copy&#34;&#xD;&#xA;            &gt;&#xD;&#xA;              &lt;span class=&#34;copy-icon&#34;&gt;&#xD;&#xA;                &lt;svg class=&#34;h-3 w-3&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;              &lt;/span&gt;&#xD;&#xA;              &lt;span class=&#34;copy-text hidden sm:inline&#34;&gt;Copy&lt;/span&gt;&#xD;&#xA;            &lt;/button&gt;&#xD;&#xA;            &lt;div class=&#34;whitespace-pre&#34;&gt;&lt;div&gt;&lt;span class=&#34;term-prompt font-semibold select-none&#34;&gt;$&lt;/span&#xD;&#xA;                    &gt;&lt;span class=&#34;pl-2&#34;&gt;gdb&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;          &lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;(gdb) run  # 启动程序&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;(gdb) r&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;(gdb) continue # 中断程序后，继续执行&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;(gdb) c&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;p&gt;&lt;strong&gt;执行：&lt;/strong&gt;&lt;/p&gt;</description>
