			<item>
				<title>线程管理</title>
				<link>http://localhost:1313/cpp_notes/posts/cppconcurrency/managethread/</link>
				<pubDate>Sat, 02 Mar 2024 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/cpp_notes/posts/cppconcurrency/managethread/</guid>
				<description>&lt;ul&gt;&#xA;&lt;li&gt;&lt;a&#xD;&#xA;    href=&#34;https://github.com/downdemo/Cpp-Concurrency-in-Action-2ed&#34;target=&#34;_blank&#34;&#xD;&#xA;    class=&#34;inline-flex items-center gap-1&#34;&#xD;&#xA;  &gt;cpp并发编程笔记（比书简单）&lt;svg class=&#34;h-3 w-3 flex-shrink-0&#34; id=&#34;external-link&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;path fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6&#34;/&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a&#xD;&#xA;    href=&#34;https://github.com/xiaoweiChen/CPP-Concurrency-In-Action-2ed-2019&#34;target=&#34;_blank&#34;&#xD;&#xA;    class=&#34;inline-flex items-center gap-1&#34;&#xD;&#xA;  &gt;cpp并发编程翻译&lt;svg class=&#34;h-3 w-3 flex-shrink-0&#34; id=&#34;external-link&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;path fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6&#34;/&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h1 id=&#34;开发环境&#34;&gt;开发环境&lt;a href=&#34;#%e5%bc%80%e5%8f%91%e7%8e%af%e5%a2%83&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;div&#xD;&#xA;    class=&#34;alert alert-note my-6 overflow-hidden rounded-lg transition-all duration-200 ease-out hover:-translate-y-0.5 hover:shadow-md&#34;&#xD;&#xA;    style=&#34;background-color: color-mix(in srgb, var(--color-note) 10%, transparent);&#xD;&#xA;              border-left-color: var(--color-note);&#xD;&#xA;              --hover-bg: color-mix(in srgb, var(--color-note) 15%, transparent);&#34;&#xD;&#xA;    onmouseover=&#34;this.style.backgroundColor = this.style.getPropertyValue(&#39;--hover-bg&#39;)&#34;&#xD;&#xA;    onmouseout=&#34;this.style.backgroundColor = &#39;color-mix(in srgb, var(--color-note) 10%, transparent)&#39;&#34;&#xD;&#xA;    role=&#34;alert&#34;&#xD;&#xA;    aria-labelledby=&#34;alert-0-title&#34;&#xD;&#xA;  &gt;&#xD;&#xA;    &#xD;&#xA;    &lt;div&#xD;&#xA;      class=&#34; flex items-center justify-between px-6 py-6&#34;&#xD;&#xA;      &#xD;&#xA;    &gt;&#xD;&#xA;      &lt;div class=&#34;flex items-center gap-3&#34;&gt;&#xD;&#xA;        &#xD;&#xA;        &lt;h4 id=&#34;alert-0-title&#34; class=&#34;text-foreground/90 m-0 font-semibold&#34;&gt;&#xD;&#xA;          Note&#xD;&#xA;        &lt;/h4&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;      &#xD;&#xA;      &#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &#xD;&#xA;    &lt;div&#xD;&#xA;      id=&#34;alert-0-content&#34;&#xD;&#xA;      class=&#34;alert-content  px-6 pb-6&#34;&#xD;&#xA;    &gt;&#xD;&#xA;      &lt;div class=&#34;prose prose-sm text-foreground/90 max-w-none&#34;&gt;&#xD;&#xA;        &lt;p&gt;需要编译器支持 &lt;code&gt;C++11&lt;/code&gt;、&lt;code&gt;C++14&lt;/code&gt;、&lt;code&gt;C++17&lt;/code&gt;特性&lt;/p&gt;</description>
			</item>
			<item>
				<title>MapReduce</title>
				<link>http://localhost:1313/cpp_notes/posts/distribute/mapreduce/</link>
				<pubDate>Sat, 19 Jul 2025 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/cpp_notes/posts/distribute/mapreduce/</guid>
				<description>&lt;h1 id=&#34;原理&#34;&gt;原理&lt;a href=&#34;#%e5%8e%9f%e7%90%86&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;p&gt;&lt;code&gt;MapReduce&lt;/code&gt; ：一种分布式并行计算框架，最初由 Google 提出，用于处理大规模数据集&lt;/p&gt;&#xA;&lt;ol&gt;&#xA;&lt;li&gt;&lt;code&gt;Map&lt;/code&gt;：将输入数据分成多个小块&lt;code&gt;InputSplit&lt;/code&gt;，即 &lt;code&gt;&amp;lt;k1, v1&amp;gt;&lt;/code&gt; （其中 &lt;code&gt;k&lt;/code&gt; 是标记， &lt;code&gt;v1&lt;/code&gt; 是输入的一块数据），然后通过 &lt;code&gt;Map&lt;/code&gt; 函数得到结果 &lt;code&gt;&amp;lt;k2,v2&amp;gt;&lt;/code&gt; （&lt;code&gt;v2&lt;/code&gt;是计算结果）&lt;/li&gt;&#xA;&lt;li&gt;&lt;code&gt;Shuffle&lt;/code&gt; ：对 Mapper 的输出 &lt;code&gt;&amp;lt;k2,v2&amp;gt;&lt;/code&gt; 进行分区、排序和分组，并将 &lt;code&gt;k2&lt;/code&gt; 值一样的数据聚合在一起得到 &lt;code&gt;&amp;lt;k2, List(v2)&amp;gt;&lt;/code&gt;。&lt;/li&gt;&#xA;&lt;li&gt;&lt;code&gt;Reduce&lt;/code&gt;：Reducer 接收 &lt;code&gt;&amp;lt;k2, List(v2)&amp;gt;&lt;/code&gt;，对数据进行合并计算，输出最终结果 &lt;code&gt;&amp;lt;k3, v3&amp;gt;&lt;/code&gt; (&lt;code&gt;v3&lt;/code&gt;最终期望的结果)&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;p&gt;对于复杂业务可以定义多对 &lt;code&gt;Mapper&lt;/code&gt; 与 &lt;code&gt;Reducer&lt;/code&gt; 处理函数，然后多次运行 &lt;code&gt;MapReduce&lt;/code&gt;。&lt;strong&gt;&lt;code&gt;MapReduce&lt;/code&gt; 模型的瓶颈是存在大量的网络通信&lt;/strong&gt;&lt;/p&gt;</description>
			</item>
			<item>
				<title>Ansys HPC</title>
				<link>http://localhost:1313/cpp_notes/posts/distributecluster/ansys/</link>
				<pubDate>Sun, 30 Mar 2025 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/cpp_notes/posts/distributecluster/ansys/</guid>
				<description>&lt;ul&gt;&#xA;&lt;li&gt;&lt;a&#xD;&#xA;    href=&#34;https://ansyshelp.ansys.com/public//////Views/Secured/corp/v242/en/wb_rsm/wb_solution_job_status.html&#34;target=&#34;_blank&#34;&#xD;&#xA;    class=&#34;inline-flex items-center gap-1&#34;&#xD;&#xA;  &gt;Ansys RSM&lt;svg class=&#34;h-3 w-3 flex-shrink-0&#34; id=&#34;external-link&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;path fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6&#34;/&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h1 id=&#34;概念&#34;&gt;概念&lt;a href=&#34;#%e6%a6%82%e5%bf%b5&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;ul&gt;&#xA;&lt;li&gt;&lt;strong&gt;任务&lt;code&gt;Job&lt;/code&gt;&lt;/strong&gt; : 从客户端提交的需要使用 RSM 集群处理任务\&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;客户机&lt;code&gt;Client Machine&lt;/code&gt;&lt;/strong&gt; : 安装有 Ansys 程序，且向 RSM 提交任务的机器&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;客户端&lt;code&gt;Client Application&lt;/code&gt;&lt;/strong&gt; : 提交 RSM 任务的 Ansys 程序&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;HPC 资源 &lt;code&gt;HPC Resource&lt;/code&gt;&lt;/strong&gt; : 支持高性能计算的系统，例如集群、云计算&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;节点 &lt;code&gt;Node&lt;/code&gt;&lt;/strong&gt; : HPC 中的单个计算机器&#xA;&lt;ul&gt;&#xA;&lt;li&gt;头节点 &lt;code&gt;Head Node&lt;/code&gt; : 具有任务接收与分发功能的节点，也被称之为 &lt;code&gt;submit host&lt;/code&gt;&lt;/li&gt;&#xA;&lt;li&gt;执行节点 &lt;code&gt;Execution Node&lt;/code&gt; : 只负责计算的节点&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;队列 &lt;code&gt;Queue&lt;/code&gt;&lt;/strong&gt; : 存放待执行任务的队列&#xA;&lt;ul&gt;&#xA;&lt;li&gt;&lt;code&gt;RSM Queue&lt;/code&gt; : 在 RSM 系统中所使用的任务队列，会被转换为 &lt;code&gt;HPC Queue&lt;/code&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;code&gt;HPC Queue&lt;/code&gt; : 在 HPC 系统中所使用的任务队列&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;p&gt;&#xD;&#xA;&lt;figure&#xD;&#xA;  class=&#34;image-figure not-prose my-8&#34;&#xD;&#xA;  data-lightbox-enabled=&#34;&#xD;&#xA;    true&#xD;&#xA;  &#34;&#xD;&#xA;  data-gallery-type=&#34;auto&#34;&#xD;&#xA;  data-image-width=&#34;475&#34;&#xD;&#xA;  data-image-height=&#34;282&#34;&#xD;&#xA;  data-image-src=&#34;http://localhost:1313/cpp_notes/posts/distributecluster/ansys/resources/cluster-diagram.png&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;image-container&#34;&gt;&#xD;&#xA;    &lt;img&#xD;&#xA;    src=&#34;http://localhost:1313/cpp_notes/posts/distributecluster/ansys/resources/cluster-diagram.png&#34;&#xD;&#xA;    alt=&#34;alt&#34;&#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;      &#xD;&#xA;      &#xD;&#xA;        &#xD;&#xA;          width=&#34;475&#34; height=&#34;282&#34;&#xD;&#xA;        &#xD;&#xA;      &#xD;&#xA;    &#xD;&#xA;    loading=&#34;lazy&#34;&#xD;&#xA;    decoding=&#34;async&#34;&#xD;&#xA;    data-gallery-src=&#34;http://localhost:1313/cpp_notes/posts/distributecluster/ansys/resources/cluster-diagram.png&#34;&#xD;&#xA;    data-gallery-alt=&#34;alt&#34;&#xD;&#xA;    data-gallery-title=&#34;&#34;&#xD;&#xA;  /&gt;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;  &lt;/figure&gt;&#xD;&#xA;&lt;/p&gt;</description>
			</item>
			<item>
				<title>并行算法</title>
				<link>http://localhost:1313/cpp_notes/posts/algorithms/parallel/</link>
				<pubDate>Sun, 24 Nov 2024 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/cpp_notes/posts/algorithms/parallel/</guid>
				<description>&lt;h1 id=&#34;逻辑模型&#34;&gt;逻辑模型&lt;a href=&#34;#%e9%80%bb%e8%be%91%e6%a8%a1%e5%9e%8b&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;p&gt;&lt;code&gt;Dynamic Multithreading&lt;/code&gt; : 共享内存的基础上，实现线程的异步运行&lt;/p&gt;&#xA;&lt;div&#xD;&#xA;  class=&#34;code-block-container border-border bg-card my-6 overflow-hidden rounded-xl border shadow-sm transition-all duration-200 ease-out hover:-translate-y-0.5 hover:shadow-md&#34;&#xD;&#xA;  data-code-block&#xD;&#xA;  data-code-id=&#34;code-0&#34;&#xD;&#xA;  data-collapsible=&#34;true&#34;&#xD;&#xA;  data-default-state=&#34;expanded&#34;&#xD;&#xA;  data-collapsed=&#34;false&#34;&#xD;&#xA;  data-auto-collapse-lines=&#34;30&#34;&#xD;&#xA;  data-auto-collapse-height=&#34;400&#34;&#xD;&#xA;  data-collapsed-height=&#34;120&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &#xD;&#xA;  &lt;div&#xD;&#xA;    class=&#34;code-block-header bg-muted/30 border-border flex items-center justify-between border-b px-4 py-3&#34;&#xD;&#xA;  &gt;&#xD;&#xA;    &#xD;&#xA;    &lt;div class=&#34;flex items-center gap-2&#34;&gt;&#xD;&#xA;      &lt;div class=&#34;text-muted-foreground shrink-0&#34;&gt;&#xD;&#xA;        &lt;svg class=&#34;h-4 w-4&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4&#34; /&gt;&