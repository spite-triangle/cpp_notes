				<description>&lt;h1 id=&#34;流程模型&#34;&gt;流程模型&lt;a href=&#34;#%e6%b5%81%e7%a8%8b%e6%a8%a1%e5%9e%8b&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;p&gt;&#xD;&#xA;&lt;figure&#xD;&#xA;  class=&#34;image-figure not-prose my-8&#34;&#xD;&#xA;  data-lightbox-enabled=&#34;&#xD;&#xA;    true&#xD;&#xA;  &#34;&#xD;&#xA;  data-gallery-type=&#34;auto&#34;&#xD;&#xA;  data-image-width=&#34;636&#34;&#xD;&#xA;  data-image-height=&#34;248&#34;&#xD;&#xA;  data-image-src=&#34;http://localhost:1313/cpp_notes/posts/electron/model/resources/electron_structure.png&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;image-container&#34;&gt;&#xD;&#xA;    &lt;img&#xD;&#xA;    src=&#34;http://localhost:1313/cpp_notes/posts/electron/model/resources/electron_structure.png&#34;&#xD;&#xA;    alt=&#34;alt&#34;&#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;      &#xD;&#xA;      &#xD;&#xA;        &#xD;&#xA;          width=&#34;636&#34; height=&#34;248&#34;&#xD;&#xA;        &#xD;&#xA;      &#xD;&#xA;    &#xD;&#xA;    loading=&#34;lazy&#34;&#xD;&#xA;    decoding=&#34;async&#34;&#xD;&#xA;    data-gallery-src=&#34;http://localhost:1313/cpp_notes/posts/electron/model/resources/electron_structure.png&#34;&#xD;&#xA;    data-gallery-alt=&#34;alt&#34;&#xD;&#xA;    data-gallery-title=&#34;&#34;&#xD;&#xA;  /&gt;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;  &lt;/figure&gt;&#xD;&#xA;&lt;/p&gt;&#xA;&lt;p&gt;&lt;code&gt;electron&lt;/code&gt; 平台环境主要就三大部分&lt;/p&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;&lt;strong&gt;主进程&lt;/strong&gt; ： &lt;code&gt;nodejs&lt;/code&gt; 环境，管理所有的界面（即渲染进程），且封装操作系统接口&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;渲染进程&lt;/strong&gt; ： &lt;code&gt;chromium&lt;/code&gt; 浏览器环境，通过 &lt;code&gt;web&lt;/code&gt; 技术实现界面窗口&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;进程通信&lt;/strong&gt; ： 实现「主进程」与 「渲染进程」的消息通信&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;div&#xD;&#xA;  class=&#34;term-block my-6 overflow-hidden rounded-xl border shadow-sm&#34;&#xD;&#xA;  data-term-block&#xD;&#xA;  data-term-id=&#34;term-0&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;term-header flex items-center justify-between border-b px-4 py-3&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;flex items-center gap-3&#34;&gt;&#xD;&#xA;      &lt;span class=&#34;flex items-center gap-1.5&#34; aria-hidden=&#34;true&#34;&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#ff5f57]&#34;&gt;&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#febc2e]&#34;&gt;&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;h-3 w-3 rounded-full bg-[#28c840]&#34;&gt;&lt;/span&gt;&#xD;&#xA;      &lt;/span&gt;&#xD;&#xA;      &lt;span class=&#34;term-title text-sm font-medium&#34;&gt;Terminal&lt;/span&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;  &lt;div class=&#34;overflow-x-auto p-4&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;term-body font-mono text-sm leading-relaxed&#34;&gt;&lt;div class=&#34;group relative pr-10&#34; data-term-group data-copy=&#34;tree ./src&#34;&gt;&#xD;&#xA;            &lt;button&#xD;&#xA;              class=&#34;term-copy-btn absolute top-0 right-0 z-10 flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium opacity-0 transition-all duration-200 ease-out group-hover:opacity-100 focus:ring-2 focus:ring-[#3fb950]/20 focus:outline-none&#34;&#xD;&#xA;              type=&#34;button&#34;&#xD;&#xA;              data-term-copy&#xD;&#xA;              data-label-copy=&#34;Copy&#34;&#xD;&#xA;              data-label-copied=&#34;Copied&#34;&#xD;&#xA;              title=&#34;Copy&#34;&#xD;&#xA;              aria-label=&#34;Copy&#34;&#xD;&#xA;            &gt;&#xD;&#xA;              &lt;span class=&#34;copy-icon&#34;&gt;&#xD;&#xA;                &lt;svg class=&#34;h-3 w-3&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;              &lt;/span&gt;&#xD;&#xA;              &lt;span class=&#34;copy-text hidden sm:inline&#34;&gt;Copy&lt;/span&gt;&#xD;&#xA;            &lt;/button&gt;&#xD;&#xA;            &lt;div class=&#34;whitespace-pre&#34;&gt;&lt;div&gt;&lt;span class=&#34;term-prompt font-semibold select-none&#34;&gt;$&lt;/span&#xD;&#xA;                    &gt;&lt;span class=&#34;pl-2&#34;&gt;tree ./src&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;          &lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt; ./src&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt; ├── main                    # 主进程，控制应用程序&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt; │   └── index.ts&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt; ├── preload                 # 主进程与渲染进程通信的中间件&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt; │   ├── index.d.ts&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt; │   └── index.ts&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt; └── renderer                # 渲染进程，vue 项目工程&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;     ├── index.html&lt;/div&gt;&lt;div class=&#34;term-output whitespace-pre&#34;&gt;     └── src&lt;/div&gt;&lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;h1 id=&#34;主进程&#34;&gt;主进程&lt;a href=&#34;#%e4%b8%bb%e8%bf%9b%e7%a8%8b&#34; class=&#34;heading-anchor&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;svg class=&#34;h-4 w-4&#34; aria-hidden=&#34;true&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; viewBox=&#34;0 0 24 24&#34;&gt;&lt;g fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34;&gt;&lt;path d=&#34;M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71&#34;/&gt;&lt;path d=&#34;M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71&#34;/&gt;&lt;/g&gt;&lt;/svg&gt;&lt;/a&gt;&lt;/h1&gt;&lt;ul&gt;&#xA;&lt;li&gt;&lt;code&gt;main/index.ts&lt;/code&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;div&#xD;&#xA;  class=&#34;code-block-container border-border bg-card my-6 overflow-hidden rounded-xl border shadow-sm transition-all duration-200 ease-out hover:-translate-y-0.5 hover:shadow-md&#34;&#xD;&#xA;  data-code-block&#xD;&#xA;  data-code-id=&#34;code-1&#34;&#xD;&#xA;  data-collapsible=&#34;true&#34;&#xD;&#xA;  data-default-state=&#34;expanded&#34;&#xD;&#xA;  data-collapsed=&#34;false&#34;&#xD;&#xA;  data-auto-collapse-lines=&#34;30&#34;&#xD;&#xA;  data-auto-collapse-height=&#34;400&#34;&#xD;&#xA;  data-collapsed-height=&#34;120&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &#xD;&#xA;  &lt;div&#xD;&#xA;    class=&#34;code-block-header bg-muted/30 border-border flex items-center justify-between border-b px-4 py-3&#34;&#xD;&#xA;  &gt;&#xD;&#xA;    &#xD;&#xA;    &lt;div class=&#34;flex items-center gap-2&#34;&gt;&#xD;&#xA;      &lt;div class=&#34;text-muted-foreground shrink-0&#34;&gt;&#xD;&#xA;        &lt;svg class=&#34;h-4 w-4&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;      &lt;span class=&#34;text-muted-foreground text-sm font-medium&#34;&gt;&#xD;&#xA;        TS&#xD;&#xA;      &lt;/span&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &#xD;&#xA;    &lt;div class=&#34;flex items-center gap-2&#34;&gt;&#xD;&#xA;      &lt;button&#xD;&#xA;          class=&#34;collapse-code-btn text-muted-foreground hover:text-primary hover:bg-primary/10 focus:ring-primary/20 flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium transition-all duration-200 ease-out focus:ring-2 focus:outline-none&#34;&#xD;&#xA;          type=&#34;button&#34;&#xD;&#xA;          data-code-action=&#34;toggle-collapse&#34;&#xD;&#xA;          data-label-expand=&#34;Expand&#34;&#xD;&#xA;          data-label-collapse=&#34;Collapse&#34;&#xD;&#xA;          title=&#34;Collapse&#34;&#xD;&#xA;          aria-label=&#34;Collapse&#34;&#xD;&#xA;          aria-controls=&#34;code-1&#34;&#xD;&#xA;          aria-expanded=&#34;true&#34;&#xD;&#xA;        &gt;&#xD;&#xA;          &lt;span class=&#34;collapse-chevron transition-transform duration-200 ease-out&#34;&gt;&#xD;&#xA;            &lt;svg class=&#34;h-3 w-3&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M19 9l-7 7-7-7&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;          &lt;/span&gt;&#xD;&#xA;          &lt;span class=&#34;collapse-text hidden sm:inline&#34;&gt;Collapse&lt;/span&gt;&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;      &lt;button&#xD;&#xA;        class=&#34;copy-code-btn text-muted-foreground hover:text-primary hover:bg-primary/10 focus:ring-primary/20 flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium transition-all duration-200 ease-out focus:ring-2 focus:outline-none&#34;&#xD;&#xA;        type=&#34;button&#34;&#xD;&#xA;        data-code-action=&#34;copy&#34;&#xD;&#xA;        data-label-copy=&#34;Copy&#34;&#xD;&#xA;        data-label-copied=&#34;Copied&#34;&#xD;&#xA;        title=&#34;Copy&#34;&#xD;&#xA;        aria-label=&#34;Copy&#34;&#xD;&#xA;      &gt;&#xD;&#xA;        &lt;span class=&#34;copy-icon&#34;&gt;&#xD;&#xA;          &lt;svg class=&#34;h-3 w-3&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; viewBox=&#34;0 0 24 24&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34;&gt;&#xD;&#xA;  &lt;path stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34; stroke-width=&#34;2&#34; d=&#34;M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z&#34; /&gt;&#xD;&#xA;&lt;/svg&gt;&#xD;&#xA;        &lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;copy-text hidden sm:inline&#34;&gt;Copy&lt;/span&gt;&#xD;&#xA;      &lt;/button&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;  &#xD;&#xA;  &lt;div class=&#34;code-block-content relative&#34; id=&#34;code-1&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-ts&#34; data-lang=&#34;ts&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;kr&#34;&gt;import&lt;/span&gt; &lt;span class=&#34;p&#34;&gt;{&lt;/span&gt; &lt;span class=&#34;nx&#34;&gt;app&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;,&lt;/span&gt; &lt;span class=&#34;nx&#34;&gt;shell&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;,&lt;/span&gt; &lt;span class=&#34;nx&#34;&gt;BrowserWindow&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;,&lt;/span&gt; &lt;span class=&#34;nx&#34;&gt;ipcMain&lt;/span&gt; &lt;span class=&#34;p&#34;&gt;}&lt;/span&gt; &lt;span class=&#34;kr&#34;&gt;from&lt;/span&gt; &lt;span class=&#34;s1&#34;&gt;&amp;#39;electron&amp;#39;&lt;/span&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;kr&#34;&gt;import&lt;/span&gt; &lt;span class=&#34;p&#34;&gt;{&lt;/span&gt; &lt;span class=&#34;nx&#34;